##calculations will be performed by tbg##

# settings that can be controlled by environment variables before submit

# 8 gpus per node if we need more than 8 gpus else same count as TBG_tasks

## end calculations ##


echo 'Running program...'

cd /home/optolo43/Fusion_Setups/TestRun

export MODULES_NO_OUTPUT=1
. /home/optolo43/gpu_a30_picongpu.profile
unset MODULES_NO_OUTPUT

#set user rights to u=rwx;g=r-x;o=---
umask 0027

mkdir simOutput 2> /dev/null
cd simOutput

# test if cuda_memtest binary is available
if [ -f /home/optolo43/Fusion_Setups/TestRun/input/bin/cuda_memtest ] ; then
  mpiexec --mca mpi_leave_pinned 0 -npernode 1 -n 1 /home/optolo43/Fusion_Setups/TestRun/input/bin/cuda_memtest.sh
else
  echo "Note: GPU memory test was skipped as no binary 'cuda_memtest' available. This does not affect PIConGPU, starting it now" >&2
fi

if [ $? -eq 0 ] ; then
  mpiexec --mca mpi_leave_pinned 0 -npernode 1 -n 1 /home/optolo43/Fusion_Setups/TestRun/input/bin/picongpu --author "optolo43 <someone@example.com>" -d 1 1 1 -g 1 1 1 -s 7500 --periodic 1 1 1 --t_energyHistogram.period 1 --t_energyHistogram.filter all --t_energyHistogram.binCount 1024 --t_energyHistogram.minEnergy 0 --t_energyHistogram.maxEnergy 500000 --d_energyHistogram.period 1 --d_energyHistogram.filter all --d_energyHistogram.binCount 1024 --d_energyHistogram.minEnergy 0 --d_energyHistogram.maxEnergy 500000 --n_energyHistogram.period 1 --n_energyHistogram.filter all --n_energyHistogram.binCount 1024 --n_energyHistogram.minEnergy 0 --n_energyHistogram.maxEnergy 500000 --He4_energyHistogram.period 1 --He4_energyHistogram.filter all --He4_energyHistogram.binCount 1024 --He4_energyHistogram.minEnergy 0 --He4_energyHistogram.maxEnergy 500000 --d_png.period 100 --d_png.axis yx --d_png.slicePoint 0.5 --d_png.folder pngdectronsYX --t_png.period 100 --t_png.axis yx --t_png.slicePoint 0.5 --t_png.folder pngdectronsYX --n_png.period 100 --n_png.axis yx --n_png.slicePoint 0.5 --n_png.folder pngdectronsYX --He4_png.period 100 --He4_png.axis yx --He4_png.slicePoint 0.5 --He4_png.folder pngdectronsYX --t_macroParticlesCount.period 1 --d_macroParticlesCount.period 1 --n_macroParticlesCount.period 1 --He4_macroParticlesCount.period 1 --versionOnce | tee output
fi

#this script was created with call cd /home/optolo43/Fusion_Setups; /home/optolo43/src/picongpu/bin/tbg -s bash -t -c etc/picongpu/1.cfg -f TestRun
