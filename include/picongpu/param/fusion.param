#pragma once

#include "picongpu/param/particleFilters.param"
#include "picongpu/particles/fusion/fusion.def"
#include "picongpu/plugins/misc/SpeciesFilter.hpp"

#include <pmacc/meta/conversion/MakeSeq.hpp>


#ifndef PARAM_DYNAMIC_LOG
#    define PARAM_DYNAMIC_LOG 0
#endif

namespace picongpu
{
    namespace particles
    {
        namespace fusion
        {
            namespace precision
            {
                using float_COLL = float_64;
            } // namespace precision

            using namespace picongpu::plugins;

            // not ideal, better would be to combine filters with an AND but it is ok


            /// @brief Defines reactants, products, and cross-section parameters for the
            /// D + D -> p + T fusion reaction branch.
            struct DD_pT
            {
                using reactants = pmacc::mp_list<
                    Pair<PIC_Deuterons, PIC_Deuterons>
                    >;

                using products = pmacc::mp_list<
                    Pair<PIC_Protons, PIC_Tritons>
                    >;

                // Parameters from "D(d,p)T" column in the provided table.
                struct Params
                {
                    static constexpr float_X BG = 31.3970_X;

                    static constexpr float_X A1 = 5.5576e4_X;
                    static constexpr float_X A2 = 2.1054e2_X;
                    static constexpr float_X A3 = -3.2638e-2_X;
                    static constexpr float_X A4 = 1.4987e-6_X;
                    static constexpr float_X A5 = 1.8181e-10_X;

                    static constexpr float_X B1 = 0.0_X;
                    static constexpr float_X B2 = 0.0_X;
                    static constexpr float_X B3 = 0.0_X;
                    static constexpr float_X B4 = 0.0_X;
                };

                using ColliderFunctor = relativistic::FusionFunctor<Params>;
            };


            /// @brief Defines reactants, products, and cross-section parameters for the
            /// D + D -> n + 3He fusion reaction branch.
            struct DD_nHe3
            {
                using reactants = pmacc::mp_list<
                    Pair<PIC_Deuterons, PIC_Deuterons>
                    >;

                using products = pmacc::mp_list<
                    Pair<PIC_Neutrons, PIC_He3>
                    >;

                // Parameters from "D(d,n)3He" column in the provided table.
                struct Params
                {
                    static constexpr float_X BG = 31.3970_X;

                    static constexpr float_X A1 = 5.3701e4_X;
                    static constexpr float_X A2 = 3.3027e2_X;
                    static constexpr float_X A3 = -1.2706e-1_X;
                    static constexpr float_X A4 = 2.9327e-5_X;
                    static constexpr float_X A5 = -2.5151e-9_X;

                    static constexpr float_X B1 = 0.0_X;
                    static constexpr float_X B2 = 0.0_X;
                    static constexpr float_X B3 = 0.0_X;
                    static constexpr float_X B4 = 0.0_X;
                };

                using ColliderFunctor = relativistic::FusionFunctor<Params>;
            };


            /** FusionPipeline defines in which order species interact with each other
             *
             * the functors are called in order (from first to last functor)
             */
            // using FusionPipeline = pmacc::mp_list<
                // Collider<DD::ColliderFunctor, DD::reactants, DD::products, OneFilter<filter::All>>>;

            using FusionPipeline = pmacc::mp_list<ColliderFromStruct<DD_nHe3>>;

            /** Chunk size used for cell list allocations.
             *
             * To reduce the fragmentation of the heap memory on accelerators the collision algorithm is allocating a
             * multiple of this value to store a cell list of particle IDs. The value must be non zero.
             */
            constexpr uint32_t cellListChunkSize = TYPICAL_PARTICLES_PER_CELL;
            // if weighting of the products were to be less or equal than productMinWeighting we set  Fmult = std::max(1,productWeighting/productMinWeighting);
            constexpr float_X productMinWeighting = 10;
            constexpr uint32_t maxFmult = 10000;
            constexpr bool debugFusion = false;
            constexpr bool alwaysFuseQ = false;
        } // namespace fusion
    } // namespace particles
} // namespace picongpu
