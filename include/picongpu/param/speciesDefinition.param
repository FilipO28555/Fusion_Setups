#pragma once


#include "picongpu/particles/Particles.hpp"

#include <pmacc/identifier/value_identifier.hpp>
#include <pmacc/meta/String.hpp>
#include <pmacc/meta/conversion/MakeSeq.hpp>
#include <pmacc/particles/Identifier.hpp>
#include <pmacc/particles/traits/FilterByFlag.hpp>

namespace picongpu
{
/*########################### define particle attributes #####################*/
    // value_identifier(bool, DriftFlag, false); // flag to check if drift was applied

    /** describe attributes of a particle*/
    using DefaultParticleAttributes = MakeSeq_t<
        position<position_pic>,
        momentum,
        weighting,
        particleId,
        driftFlag<DriftFlag>
        >;

    /*########################### end particle attributes ########################*/

    /*########################### define species #################################*/
    constexpr float_X amu = 1.0_X / 5.48579909065e-4_X; 
    
    /*--------------------------- electrons --------------------------------------*/

    /* ratio relative to base charge and base mass */
    value_identifier(float_X, MassRatioElectrons, 1.0);
    value_identifier(float_X, ChargeRatioElectrons, -1.0);
    // value_identifier(bool, DriftFlagElectrons, false); // flag to check if drift was applied

    using ParticleFlagsElectrons = MakeSeq_t<
        particlePusher<UsedParticlePusher>,
        shape<UsedParticleShape>,
        interpolation<UsedField2Particle>,
        massRatio<MassRatioElectrons>,
        chargeRatio<ChargeRatioElectrons>>;
        // driftFlag<DriftFlagElectrons>>;

    /* define species electrons */
    using PIC_Electrons = Particles<PMACC_CSTRING("e"), ParticleFlagsElectrons, DefaultParticleAttributes>;

    /*--------------------------- Neutrons --------------------------------------*/

    /* ratio relative to base charge and base mass */
    value_identifier(float_X, MassRatioNeutrons, 1.00866491595*amu);
    value_identifier(float_X, ChargeRatioNeutrons, 0.0);
    // value_identifier(bool, DriftFlagNeutrons, false); // flag to check if drift was applied

    using ParticleFlagsNeutrons = MakeSeq_t<
        particlePusher<UsedParticlePusher>,
        shape<UsedParticleShape>,
        interpolation<UsedField2Particle>,
        massRatio<MassRatioNeutrons>,
        chargeRatio<ChargeRatioNeutrons>>;
        // driftFlag<DriftFlagNeutrons>>;

    /* define species neutrons */
    using PIC_Neutrons = Particles<PMACC_CSTRING("n"), ParticleFlagsNeutrons, DefaultParticleAttributes>;

    /*--------------------------- Protons --------------------------------------*/

    /* ratio relative to base charge and base mass */
    value_identifier(float_X, MassRatioProtons, 1.007276466812*amu);
    value_identifier(float_X, ChargeRatioProtons, 1.0);
    // value_identifier(bool, DriftFlagProtons, false); // flag to check if drift was applied


    using ParticleFlagsProtons = MakeSeq_t<
        particlePusher<UsedParticlePusher>,
        shape<UsedParticleShape>,
        interpolation<UsedField2Particle>,
        massRatio<MassRatioProtons>,
        chargeRatio<ChargeRatioProtons>>;
        // driftFlag<DriftFlagProtons>>;

    /* define species protons */
    using PIC_Protons = Particles<PMACC_CSTRING("p"), ParticleFlagsProtons, DefaultParticleAttributes>;

    /*--------------------------- Deuterons --------------------------------------*/

    /* ratio relative to base charge and base mass */
    value_identifier(float_X, MassRatioDeuterons, 2.01410177812*amu);
    value_identifier(float_X, ChargeRatioDeuterons, 1.0);
    // value_identifier(bool, DriftFlagDeuterons, false); // flag to check if drift was applied

    using ParticleFlagsDeuterons = MakeSeq_t<
        particlePusher<UsedParticlePusher>,
        shape<UsedParticleShape>,
        interpolation<UsedField2Particle>,
        massRatio<MassRatioDeuterons>,
        chargeRatio<ChargeRatioDeuterons>>;
        // driftFlag<DriftFlagDeuterons>>;

    /* define species deuterons */
    using PIC_Deuterons = Particles<PMACC_CSTRING("d"), ParticleFlagsDeuterons, DefaultParticleAttributes>;

    /*--------------------------- Tritons --------------------------------------*/

    /* ratio relative to base charge and base mass */
    value_identifier(float_X, MassRatioTritons, 3.0160492779*amu);
    value_identifier(float_X, ChargeRatioTritons, 1.0);
    // value_identifier(bool, DriftFlagTritons, false); // flag to check if drift was applied

    using ParticleFlagsTritons = MakeSeq_t<
        particlePusher<UsedParticlePusher>,
        shape<UsedParticleShape>,
        interpolation<UsedField2Particle>,
        massRatio<MassRatioTritons>,
        chargeRatio<ChargeRatioTritons>>;
        // driftFlag<DriftFlagTritons>>;

    /* define species tritons */
    using PIC_Tritons = Particles<PMACC_CSTRING("t"), ParticleFlagsTritons, DefaultParticleAttributes>;

    /*--------------------------- He3 --------------------------------------*/

    /* ratio relative to base charge and base mass */
    value_identifier(float_X, MassRatioHe3, 3.0160293191*amu);
    value_identifier(float_X, ChargeRatioHe3, 2.0);
    // value_identifier(bool, DriftFlagHe3, false); // flag to check if drift was applied

    using ParticleFlagsHe3 = MakeSeq_t<
        particlePusher<UsedParticlePusher>,
        shape<UsedParticleShape>,
        interpolation<UsedField2Particle>,
        massRatio<MassRatioHe3>,
        chargeRatio<ChargeRatioHe3>>;
        // driftFlag<DriftFlagHe3>>;

    /* define species He3 */
    using PIC_He3 = Particles<PMACC_CSTRING("He3"), ParticleFlagsHe3, DefaultParticleAttributes>;

    /*--------------------------- He4 --------------------------------------*/

    /* ratio relative to base charge and base mass */
    value_identifier(float_X, MassRatioHe4, 4.00260325413*amu);
    value_identifier(float_X, ChargeRatioHe4, 2.0);
    // value_identifier(bool, DriftFlagHe4, false); // flag to check if drift was applied

    using ParticleFlagsHe4 = MakeSeq_t<
        particlePusher<UsedParticlePusher>,
        shape<UsedParticleShape>,
        interpolation<UsedField2Particle>,
        massRatio<MassRatioHe4>,
        chargeRatio<ChargeRatioHe4>>;
        // driftFlag<DriftFlagHe4>>;

    /* define species He4 */
    using PIC_He4 = Particles<PMACC_CSTRING("He4"), ParticleFlagsHe4, DefaultParticleAttributes>;

    /*########################### end species ####################################*/

    using VectorAllSpecies = MakeSeq_t<PIC_Electrons, PIC_Protons, PIC_Neutrons, PIC_Deuterons, PIC_Tritons, PIC_He3, PIC_He4>;

} // namespace picongpu

